# Copy to .env in the repo root. Never commit .env.

# ---- Mode -------------------------------------------------------------------
# true  = mock contacts + simulated calls, no credentials needed (UI testing only)
# false = real Twenty + real Telnyx (the default production path)
MOCK_MODE=false

# ---- Twenty CRM --------------------------------------------------------------
# Cloud: https://api.twenty.com   Self-hosted: https://your-twenty-domain
TWENTY_API_URL=https://api.twenty.com
# Twenty > Settings > API & Webhooks > + Create key
TWENTY_API_KEY=

# ---- Telnyx -----------------------------------------------------------------
# Telnyx Portal > Account > Keys & Credentials > API Keys (starts with KEY...)
TELNYX_API_KEY=
# Telnyx Portal > Voice > SIP Connections > your *Credential* connection > Connection ID
TELNYX_CONNECTION_ID=
# A Telnyx number assigned to that connection, E.164 (caller ID the prospect sees)
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
# Optional. Fetch creates a telephony credential on first run and prints its ID;
# paste it here so it is reused instead of creating a new one each restart.
TELNYX_CREDENTIAL_ID=

# ---- Storage ----------------------------------------------------------------
# Leave empty to store calls in server/data/calls.json (fine for the prototype).
# Set to use PostgreSQL: postgres://user:pass@host:5432/fetch
DATABASE_URL=
# Where calls.json / settings.json (file store) and call recordings live. Default: server/data.
# On Railway, set this to your volume's mount path (e.g. /data) so recordings survive redeploys.
DATA_DIR=

# ---- Server -----------------------------------------------------------------
PORT=4000
# Comma-separated origins allowed to call the API in development (Vite dev server)
CORS_ORIGINS=http://localhost:5173
# Comma-separated origins allowed to FRAME the Fetch app (the Twenty dock from the Chrome extension).
# Sent as Content-Security-Policy: frame-ancestors 'self' <origins>. Empty = only Fetch itself may frame it.
# e.g. https://crm.yourcompany.com
EMBED_ALLOWED_ORIGINS=

# ---- Call recording -----------------------------------------------------------
# true = record answered calls (Telnyx record_start, mp3, single channel). Check recording-consent law
# for the states you call (e.g. Florida requires all-party consent) before turning this on.
ENABLE_CALL_RECORDING=false
# Telnyx Portal > Keys & Credentials > Public Key. Verifies webhook signatures on /api/webhooks/telnyx.
# Also set the connection's webhook URL in the portal to https://<your Fetch host>/api/webhooks/telnyx
TELNYX_PUBLIC_KEY=
# Public origin of this server, used for recording links in Twenty notes. Empty = taken from the request.
PUBLIC_URL=
